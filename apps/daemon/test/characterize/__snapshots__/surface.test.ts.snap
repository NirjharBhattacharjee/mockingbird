    "name": "render",
  },
  {
    "description": "Word-by-word captions for the video \`render\` will make from these clips, or from an \`edit\` \`project\` (speed, transitions and J and L cuts included), as SRT timed to the finished video: up to \`perCue\` words a cue, the word being said marked *like this* so render draws it yellow. Edit the text if you like (fix a misheard word, mark a different word), then pass it to render's \`captions\`.",
    "inputSchema": {
      "properties": {
        "clips": {
          "description": "The same clips you'll give render, in order, in seconds",
