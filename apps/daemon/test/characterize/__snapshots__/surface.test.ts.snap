// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`every tool's name, description and input schema 1`] = `
[
  {
    "description": "Transcribe an audio or video file on this Mac (anything ffmpeg reads: m4a, mp3, wav, mp4, mov, mkv) with mockingbird's local Whisper. Returns the text in lines timestamped [mm:ss], with names fixed from the user's dictionary. Takes a few minutes for an hour of audio. \`from\`/\`to\` (seconds) transcribe one stretch only; \`words: true\` gives every word's start and end ([mm:ss.cc-mm:ss.cc] word) to cut a clip on, so keep that to a few minutes at a time. With \`project\` (an \`edit\` project file) instead of \`path\`: the words in its cut, clip by clip, each line at its time in the finished video, to read the edit and choose words for \`cut_words\`. A project's sources are heard once and kept, so this is quick after the first time. \`model\` and \`language\` given with a project are kept on it, so cut_words, captions and render hear the same words.",
    "inputSchema": {
      "properties": {
        "from": {
          "description": "Start, in seconds from the start of the file",
          "type": "number",
        },
        "language": {
          "description": "What's spoken, as a Whisper code (en, bn, de, hi, …) or auto. Default: the user's setting. Give it for mixed speech, like Bangla and English in one sentence, where detection guesses wrong.",
          "type": "string",
        },
        "model": {
          "description": "A Whisper model file in models/ for this call (\`mockingbird models\` lists them), e.g. a Bangla fine-tune for a Bangla video. Default: the one picked for the language.",
          "type": "string",
        },
        "path": {
          "description": "Absolute path to the file",
          "type": "string",
        },
        "project": {
          "description": "Absolute path to a project file from \`edit\`",
          "type": "string",
        },
        "to": {
          "description": "End, in seconds from the start of the file",
          "type": "number",
        },
        "words": {
          "description": "One line per word, with start and end",
          "type": "boolean",
        },
      },
      "type": "object",
    },
    "name": "transcribe",
  },
  {
    "description": 
"Edit a project file (project.json): an edit kept between calls, whose clips can come from several sources and whose texts, b-roll and sounds stay on their clips as the cut changes. Applies \`ops\` in order, all or none, saves, and returns an outline: each clip's place in the finished video and what's on it. Makes the file if it isn't there; no ops only reads it. You can also edit the JSON by hand. Times: a clip's from/to are seconds in its source (as \`transcribe\` gives them); a text's, insert's or sound's are seconds from the start of its \`clip\` in the finished video, or of the video without one. Ops:
- {op:"add", type:"clip", path, from, to, focus?:{x,y}, zoom?, speed?, moves?, transition?, lead?, index?}: on the main track, which plays in order with no gaps (default at the end). speed: 0.25-4. moves: [{at, focus?, zoom?, ease?}], the framing by \`at\` seconds into the clip, eased ("smooth", or "linear") from the one before: a slow push-in, a move to the other speaker. transition: {type, duration}, how the clip comes in over the end of the one before: ffmpeg xfade's fade, fadeblack, fadewhite, dissolve, wipe*, slide*, smooth*, circleopen, zoomin and others. lead: a J cut (positive: the clip's sound starts that many seconds before its picture) or an L cut (negative: the clip before's sound carries on over its picture)
- {op:"add", type:"text", text, from, to, clip?, y?}: drawn like the captions, *words* yellow
- {op:"add", type:"insert", path, from, to, clip?, box?, blend?, effects?, moves?}: a picture or video over the whole frame (b-roll). box: {x, y, w, h, path?}, 0-1 of the picture, makes it a picture in the picture; path, from track, moves it with a subject. blend: screen, multiply, overlay, softlight, lighten, darken, addition or difference (whole frame only). effects: from the catalog; chromakey keys a green screen over the cut. moves: as a clip's, a Ken Burns pan over a still
- {op:"add", type:"adjust", from, to, clip?, effects}: an adjustment layer; its effects change everything under the text (clips and inserts) for its stretch, e.g. a grade over a whole section
- {op:"add", type:"audio", path, at?, clip?, volume?, loop?, duck?}: music or a sound effect under the speech. Or generated music in place of path: generator:{generator:"/abs/lofi.js", tempo?, key?, energy?, seed?, length?} (a music generator; the bed is made at render time, as long as the video from at or \`length\` seconds if given, and kept, so it isn't made again)
- {op:"remove", id}: a clip goes with everything on it, and the cut closes up
- {op:"split", id, at}: a clip in two at a source time; what's on the second half moves with it
- {op:"trim", id, from?, to?}: a clip's source times; what's on it stays on the same picture
- {op:"move", id, index}: a clip to another place in the cut
- {op:"cut_words", text, clip?, all?} or {op:"cut_words", from, to, clip?}: cut words out of the cut by quoting them from \`transcribe\` with the project (no case or punctuation needed): \`text\` must be said once (or give \`clip\`, or \`all: true\` for every time), and from/to cuts from the first words through the last, across clips. Cuts land in the pauses, 0.2 s from the words kept; clips are split, trimmed or removed to do it
- {op:"set", id, ...fields}: change an item (null clears a field); without id, the project's size ("1080x1920" makes it vertical, cropping each clip around its focus), fps, split {top, bottom} and captions {perCue?, lit?, upper?, y?, style?} (null for none; style is as render's captionStyle). Ids are given out as c1, t1, b1, a1."
,
    "inputSchema": {
      "properties": {
        "ops": {
          "description": "The ops, in order",
          "items": {
            "type": "object",
          },
          "type": "array",
        },
        "project": {
          "description": "Absolute path to the project's .json file",
          "type": "string",
        },
      },
      "required": [
        "project",
      ],
      "type": "object",
    },
    "name": "edit",
  },
  {
    "description": "Render an \`edit\` project to MP4 (\`project\`), or cut clips out of one video and join them (\`path\` and \`clips\`), for a Short, Reel or long-form video. You choose the clips (cut on word ends from \`transcribe\` with \`words: true\`) and write the captions; this runs ffmpeg on the Mac. A project's captions are made from its clips' words when it renders. Returns the new file's path and length. It never overwrites a file.",
    "inputSchema": {
      "properties": {
        "adjust": {
          "description": "Adjustment layers: catalog effects on everything under the text (the clips and the inserts) from \`from\` to \`to\` seconds of the finished video",
          "items": {
            "properties": {
              "effects": {
                "items": {
                  "type": "object",
                },
                "type": "array",
              },
              "from": {
                "type": "number",
              },
              "to": {
                "type": "number",
              },
            },
            "required": [
              "from",
              "to",
              "effects",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "audio": {
          "description": "Sounds mixed under the speech: music (\`loop\`, \`duck\`, volume about 0.15) or a sound effect at a moment. The result is brought to -14 LUFS, the loudness Shorts, Reels and TikTok play at.",
          "items": {
            "properties": {
              "at": {
                "description": "Seconds into the finished video (default 0)",
                "type": "number",
              },
              "duck": {
                "description": "Turn it down while someone speaks",
                "type": "boolean",
              },
              "loop": {
                "description": "Repeat it to the end of the video",
                "type": "boolean",
              },
              "path": {
                "description": "Absolute path to the file",
                "type": "string",
              },
              "volume": {
                "description": "0-4 (default 1)",
                "type": "number",
              },
            },
            "required": [
              "path",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "captionStyle": {
          "description": "How the captions and texts look: a preset's name (classic, subtitle, creator, pill; default classic, white Inter 700 with a black outline and the *spoken* word yellow), or an object with \`preset\` and any of: font (Inter, Montserrat, Anton, Archivo Black, Bebas Neue, Oswald, Bangers, Space Grotesk, Playfair Display, Charis SIL), weight, upper (capitals, which get 0.06 em of tracking), tracking (em), fill, stroke and active (colours; active is the *spoken* word's), outline (0-0.5 of the text height), shadow, pill (a colour behind the spoken word), maxChars (about this many characters a line), pop (1-1.4: the spoken word that much bigger), keyword (the colour of a word written **like this**, drawn 15% bigger) and look (a motion style's id: its title font and accent, so the approved look sets the captions too). subtitle suits long-form; creator and pill suit Shorts.",
          "oneOf": [
