                  "type": "number",
                },
                "upper": {
                  "type": "boolean",
                },
                "weight": {
                  "type": "number",
                },
              },
              "type": "object",
            },
          ],
        },
        "captions": {
          "description": "SRT text timed to the finished video, not the source: subtract each clip's start, and add the length of the clips before it. Drawn onto the picture, white with a black outline; a word written *like this* is drawn yellow, for word-by-word captions with the spoken word lit. If they can't be drawn here, a subtitle track and an .srt file beside the video.",
          "type": "string",
        },
        "captionsY": {
          "description": "Where the middle of the captions sits, 0-1 of the height (default 0.7). 0.5 puts them on a split's seam.",
          "type": "number",
        },
        "clips": {
          "description": "Stretches of the source to keep, in order, in seconds",
          "items": {
            "properties": {
