exports[`the tools that need no arguments 1`] = `
"color (video): Exposure, contrast, saturation, gamma and white balance, in one pass
    exposure: -3 to 3, default 0 (stops; +1 doubles the light)
    contrast: 0 to 3, default 1 (1 leaves it)
    saturation: 0 to 3, default 1 (0 is black and white)
    gamma: 0.2 to 5, default 1 (above 1 lifts the mids)
    temperature: 1000 to 40000, default 6500 (kelvin the picture is shot at; lower warms a cold picture)
lut (video): A look from a .cube 3D LUT, at full strength
    file: an absolute path
vignette (video): Darkens the corners, to pull the eye to the middle
    amount: 0 to 1, default 0.4 (0 none, 1 strong)
sharpen (video): Unsharp mask, for soft footage
    amount: 0 to 2, default 0.5 (how much)
blur (video): Gaussian blur over the whole picture
    radius: 0.5 to 50, default 8 (pixels)
chromakey (video): Keys out a green or blue screen and takes the colour's spill off the edges. Put it on an insert, so the cut shows through where the screen was
    color: a colour like "#00ff00", default #00ff00
    similarity: 0.01 to 1, default 0.15 (how far from the colour still keys)
    blend: 0 to 1, default 0.05 (how soft the key's edge is)
    spill: 0 to 1, default 0.5 (how much spill to take off)
stabilize (video): Steadies a shaky handheld clip (ffmpeg's deshake), then zooms in a little so the moving edges stay out of frame
    strength: 0 to 1, default 0.5 (how far it searches for the shake)
    zoom: 0 to 0.2, default 0.05 (how much to crop to hide the edges)
crop (video): Cuts edges off, each 0-0.5 of the picture, leaving the rest where it was: on an insert the cut shows through, on a clip they're black
    left: 0 to 0.5, default 0 (of the width)
    right: 0 to 0.5, default 0 (of the width)
    top: 0 to 0.5, default 0 (of the height)
    bottom: 0 to 0.5, default 0 (of the height)
freeze (video): Holds the clip's first frame for its whole length while its sound plays on; split a clip where the freeze should start
interpolate (video): Smooth slow motion: a slowed clip (speed under 1) gets new in-between frames from the motion instead of repeated ones. Slow to render: 4 s at 720p took 9.5 s
reverse (video): Plays the clip backwards, picture and sound. Keep it short: the clip is held in memory
gain (audio): Raises or lowers the clip's sound by dB; a project's \`level\` sets it for each source (#265)
    db: -30 to 30, default 0 (dB; +6 is about twice as loud)
denoise (audio): Takes out steady background noise (hiss, hum, fans). Set floor to the source's noise floor from audio_stats
    amount: 0 to 1, default 0.5 (0 light, 1 strong)
    floor: -80 to -20, default -40 (dBFS where the noise sits; audio_stats on the source gives it)
highpass (audio): Cuts rumble below a frequency; 80 Hz suits speech
    frequency: 20 to 400, default 80 (Hz)
compress (audio): Evens out loud and quiet speech
    threshold: -60 to 0, default -24 (dB where it starts)
    ratio: 1 to 20, default 3 (how hard)
deess (audio): Softens harsh s and sh sounds
    amount: 0 to 1, default 0.5 (how much)

Any picture effect but interpolate takes mask: { shape: "rect" | "ellipse" | "polygon" | "subject", x, y, w, h (0-1 of the picture; a polygon has points: [[x, y], ...]), feather (0-0.5 of the width), invert, end: { x, y, w, h } to move a rect or ellipse there over the clip }, to apply it to that part of the frame only. "subject" is the person in the frame, found per frame by MODNet (\`mockingbird models pull modnet\` first): with invert, a blur or a grade on everything but them."
`;

exports[`the tools that need no arguments 2`] = `"undefined"`;
