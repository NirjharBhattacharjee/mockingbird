            ],
            "type": "object",
          },
          "type": "array",
        },
        "draft": {
          "description": "A quick preview at half the size, to check the cut before the real render: a project's 4K sources are read from small proxies of the stretches it uses, made once and kept",
          "type": "boolean",
        },
        "inserts": {
          "description": "Pictures or videos (b-roll) laid over the whole frame for a stretch of the finished video while the speech carries on, under the text. Scaled to fill; a video's own sound isn't used.",
          "items": {
            "properties": {
              "blend": {
