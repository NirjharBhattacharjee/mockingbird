{
  "name": "mockingbird",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "test:integration": "MOCKINGBIRD_INTEGRATION=1 bun test",
    "transcribe": "bun apps/daemon/src/transcribe.ts",
    "listen": "bun apps/daemon/src/listen.ts",
    "fixtures": "sh scripts/make-fixtures.sh",
    "demo": "sh scripts/render-demo.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
