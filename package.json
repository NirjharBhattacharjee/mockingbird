{
  "name": "mockingbird",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "test:integration": "MOCKINGBIRD_INTEGRATION=1 bun test",
    "transcribe": "bun apps/daemon/src/transcribe.ts",
    "fixtures": "sh scripts/make-fixtures.sh",
    "bench:models": "bun bench/models.ts",
    "kit": "bun build plugin/skills/motion-graphics/kit.ts --no-bundle --target=browser --outfile plugin/skills/motion-graphics/kit.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
